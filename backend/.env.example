# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/secure_file_transfer

# JWT Security Credentials
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# AES-256-GCM Encryption Key (32 bytes / 64 hex characters)
FILE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session Inactivity Expiration (Minutes)
SESSION_TIMEOUT_MINUTES=30

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173
